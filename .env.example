# Discord Developer Portalで発行したBotトークン
DISCORD_TOKEN=
# Discord Developer PortalのアプリケーションID（コマンド同期に使用）
DISCORD_APPLICATION_ID=
# 開発中は対象サーバーIDを指定するとスラッシュコマンドが即時反映されます（同期先がそのサーバーになります）
DISCORD_GUILD_ID=
# VOICEVOX EngineのURL
VOICEVOX_URL=http://localhost:50021
# 初期話者ID
VOICEVOX_SPEAKER=3
# 設定・キャッシュの保存先（未指定時は ./data）
DATA_DIR=./data
# TTSキャッシュの保存先（未指定時は DATA_DIR/cache/tts）
# YOMIKO_CACHE_DIR=
# TTSキャッシュの有効期間（既定 168h = 7日。単位 s/m/h/d、数値のみはミリ秒）
# YOMIKO_CACHE_TTL=168h
# TTSキャッシュの総容量上限（バイト。既定 268435456 = 256MiB）
# YOMIKO_CACHE_MAX_BYTES=268435456
# 1音声ファイルの上限（バイト。既定 33554432 = 32MiB）
# YOMIKO_MAX_AUDIO_BYTES=33554432
# VCにBotだけになったとき、自動退出するまでの待ち時間（ミリ秒。既定 60000）
# YOMIKO_AUTO_LEAVE_DELAY_MS=60000
