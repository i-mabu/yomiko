{
  "name": "yomiko",
  "version": "0.1.0",
  "description": "Discordの会話をVOICEVOXで読み上げるBot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "sync:commands": "tsx src/sync-commands.ts",
    "clear:commands": "tsx src/clear-commands.ts",
    "test": "node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "14.22.1",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
